# Next.js: frontend/.env.development.local com npm run dev.
# Para produção local, use frontend/.env.production.local com npm run build e npm start.
# Na Vercel, configure as variáveis no painel do projeto.
# Em produção use o endereço HTTPS fornecido pelo Render.
BRAWL_BACKEND_URL=http://127.0.0.1:8787
BRAWL_SITE_USER=brawl
# Gere com Preparar-Ambiente.ps1. Uso exclusivo do servidor Next.js.
BRAWL_SITE_PASSWORD=
# Mesmo valor configurado no FastAPI do ambiente correspondente.
BRAWL_SERVICE_TOKEN=
