# Windows: backend/.env.development.local ou backend/.env.production.local.
# Use Iniciar-Backend.ps1 para selecionar o ambiente.
# No Render, configure as variáveis no painel do serviço.
PYTHON_VERSION=3.12.12
# Opcional. Use Contas e dados para cadastrar jogadores no servidor.
BRAWL_PLAYER_TAG=
# Use 0 para coleta manual. Para coleta agendada, informe o intervalo em segundos.
BRAWL_COLLECTION_INTERVAL_SECONDS=300
# Mesmo valor configurado no frontend do ambiente correspondente.
BRAWL_SERVICE_TOKEN=
# Use development localmente e production nos serviços hospedados.
BRAWL_ENVIRONMENT=production
# 32 bytes aleatórios em hexadecimal. A chave da Supercell é cadastrada no painel.
BRAWL_CREDENTIAL_KEY=
# O recorte competitivo usa o Elo observado no perfil de quem forneceu o histórico.
BRAWL_META_MIN_ELO=8250
# Quantidade de perfis por execução do coletor da Meta.
BRAWL_META_PLAYERS_PER_RUN=10
# Permite que o Cron Job existente execute a Meta junto da coleta pessoal configurada.
BRAWL_META_COLLECT=0
# URL Postgres com credenciais. No Supabase, use o Session pooler e sslmode=require.
DATABASE_URL=
