# Para dev no Windows, gere backend/.env.development.local com Preparar-Ambiente.ps1 -Dev.
PYTHON_VERSION=3.12.12
# Opcional. Use Contas e dados para cadastrar jogadores no servidor.
BRAWL_PLAYER_TAG=
# Use 0 para coleta manual. Para coleta agendada, informe o intervalo em segundos.
BRAWL_COLLECTION_INTERVAL_SECONDS=300
# Mesmo valor configurado no frontend do ambiente correspondente.
BRAWL_SERVICE_TOKEN=
# Chave oficial autorizada para o IPv4 público local em dev ou para a saída do servidor em produção.
BRAWL_API_TOKEN=
# URL Postgres com credenciais. Use um banco separado em dev e sslmode=require em produção.
DATABASE_URL=
